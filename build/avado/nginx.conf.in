# HTTPS front for Jellyfin (generated for this package; app on 127.0.0.1:8096)
user __NGINX_USER__;
worker_processes 2;
pid /tmp/avado-nginx/nginx.pid;
error_log /dev/stderr error;

events {
  worker_connections 1024;
}

http {
  access_log off;
  server_tokens off;
  default_type application/octet-stream;
  client_body_temp_path /tmp/avado-nginx/body;
  proxy_temp_path /tmp/avado-nginx/proxy;
  fastcgi_temp_path /tmp/avado-nginx/fastcgi;
  uwsgi_temp_path /tmp/avado-nginx/uwsgi;
  scgi_temp_path /tmp/avado-nginx/scgi;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  ssl_certificate     /etc/avado/certs/live.crt;
  ssl_certificate_key /etc/avado/certs/live.key;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_session_cache   shared:avado:2m;

  server {
    listen 80 default_server;
    listen 443 ssl default_server;
    client_max_body_size 200m;
    absolute_redirect off;

    # "Add films and music": a small upload page made for AVADO (Jellyfin
    # itself has no upload). Files go straight into the media volume.
    location = /avado-upload {
      return 301 /avado-upload/;
    }
    location = /avado-upload/ {
      root /etc/avado/upload;
      try_files /index.html =404;
      add_header Cache-Control "no-store";
      add_header X-Frame-Options "SAMEORIGIN";
    }
    # Only a Jellyfin administrator can upload: each upload carries the
    # administrator's Jellyfin sign-in, which Jellyfin itself checks (the
    # library list answers only administrators). Only these four folders,
    # nothing can be read or deleted here.
    location ~ ^/avado-upload/put/(Films|Series|Music|Photos)/(.+)$ {
      auth_request /avado-upload-check;
      limit_except PUT { deny all; }
      alias /media/$1/$2;
      dav_methods PUT;
      create_full_put_path on;
      dav_access user:rw group:r all:r;
      client_max_body_size 0;
      client_body_temp_path /media/.avado-upload-tmp;
      client_body_timeout 300s;
    }
    location = /avado-upload-check {
      internal;
      proxy_method GET;
      proxy_pass http://127.0.0.1:8096/Library/VirtualFolders;
      proxy_pass_request_body off;
      proxy_set_header Content-Length "";
      proxy_set_header Host $host;
    }

    location / {
      proxy_pass http://127.0.0.1:8096;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 600s;
      proxy_send_timeout 600s;
      proxy_request_buffering off;
      proxy_buffering off;
    }
  }
}
